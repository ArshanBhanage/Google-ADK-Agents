#!/usr/bin/env python3
"""Fail loudly when the active Node differs from the version this repo pins.

The pin exists because the frontend and the Gemini CLI tool were tested on it. A
silent mismatch means the build a reviewer runs is not the build that was verified,
which is exactly the sort of unearned claim this project is not allowed to make.
"""

import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    expected = (ROOT / ".node-version").read_text().strip()
    node = shutil.which("node")
    if node is None:
        print(f"BLOCKED: no node on PATH; this repository pins {expected}.")
        return 2
    actual = subprocess.run(
        [node, "--version"], capture_output=True, text=True, check=True
    ).stdout.strip().lstrip("v")
    if actual != expected:
        print(
            f"BLOCKED_NODE_VERSION: active node is {actual}, this repository pins {expected}.\n"
            f"  nvm install {expected} && nvm use {expected}\n"
            "nvm reads .node-version, so `nvm use` alone is enough once it is installed."
        )
        return 2
    print(f"node {actual} matches .node-version")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
