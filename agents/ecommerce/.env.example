# Inherits Vertex project/location/model and local auth from root .env.
# Empty component values do not override nonempty root settings.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
# Real PostgreSQL DSN via secure private connection or loopback AlloyDB Auth Proxy.
DATABASE_URL=
DATABASE_MODE=local_postgres
# Exact /mcp/catalog URL. Remote Cloud Run requires an ID-token audience.
TOOLBOX_URL=
TOOLBOX_AUDIENCE=
# Authorized merchant domain; no https:// prefix. Never use a sample store.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_TOKEN_TYPE=public
SHOPIFY_API_VERSION=2026-10
# Toolbox source configuration; migration connection can use a separate admin role.
ALLOYDB_REGION=
ALLOYDB_CLUSTER=
ALLOYDB_INSTANCE=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Generated by runtime setup, separate owner connection for migrations only:
MIGRATION_DATABASE_URL=
