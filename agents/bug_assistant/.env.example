# Part C. Read path: a fine-grained PAT with read-only Issues permission on the
# repositories named below, and nothing else. Never paste it into a chat.
GITHUB_TOKEN=
# Comma-separated owner/repo this agent may read. An empty list blocks everything.
GITHUB_ALLOWED_REPOSITORIES=
# Official remote GitHub MCP server, issues toolset, read-only path.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/x/issues/readonly

# Write path. A separate gate: leave disabled unless you intend a real issue to be
# created, and use a second token scoped to write Issues on one repository.
GITHUB_WRITE_ENABLED=false
GITHUB_WRITE_TOKEN=
GITHUB_WRITE_MCP_URL=https://api.githubcopilot.com/mcp/x/issues
