# Part D. Read-only review: a fine-grained token with read access to Pull Requests
# and Contents on the repositories named below, and nothing else.
GITHUB_TOKEN=
# Comma-separated owner/repo authorized for review. An empty list blocks everything.
GITHUB_ALLOWED_REPOSITORIES=

# Posting review comments. A separate gate: leave disabled unless you intend a real
# comment to appear on a pull request, and use a second token scoped to write Pull
# Requests on one repository you own.
REVIEW_COMMENT_ENABLED=false
REVIEW_COMMENT_TOKEN=
