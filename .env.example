# Local single-user mode. Use google for verified Google ID tokens.
AUTH_MODE=local
# Required in local mode; generate at least 32 random characters locally.
LOCAL_ACCESS_TOKEN=
# Required for google mode; comma-separated allowed Google subject identifiers.
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_SUBJECTS=
# Gemini Developer API credentials and a model enabled for your project.
# List what a key may actually use; some older model IDs now 404 for new keys.
GOOGLE_API_KEY=
GEMINI_MODEL=
# gemini_grounding uses ADK's built-in google_search, which requires a Gemini model
# Optional: blank uses a real SQLite ADK session DB under .local/ (local development only).
# A deployed service must use a durable shared database.
SESSION_DATABASE_URL=

# Backend selection. TRUE routes Gemini calls through Vertex AI, which bills the
# Cloud project and therefore consumes Google Cloud Free Trial credits. FALSE uses
# the Gemini Developer API key, which bills a separate pipeline those credits do
# not cover. Vertex AI authenticates with application default credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Required when GOOGLE_GENAI_USE_VERTEXAI=TRUE.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Part B. Absolute path to the directory the Gemini CLI may read. It must hold
# no credentials; the adapter refuses a workspace containing any.
GEMINI_WORKSPACE=
# Blank uses the pinned install under infra/gemini-cli.
GEMINI_CLI_PATH=
