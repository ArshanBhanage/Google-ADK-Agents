# Local single-user mode. Use google for verified Google ID tokens.
AUTH_MODE=local
# Required in local mode; generate at least 32 random characters locally.
LOCAL_ACCESS_TOKEN=
# Required for google mode; comma-separated allowed Google subject identifiers.
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_SUBJECTS=
# Gemini Developer API credentials and a model enabled for your project.
GOOGLE_API_KEY=
GEMINI_MODEL=
# Optional: blank uses a real SQLite ADK session DB under .local/ (local development only).
# A deployed service must use a durable shared database.
SESSION_DATABASE_URL=
